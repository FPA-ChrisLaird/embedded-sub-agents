{
  "$schema": "https://opencode.ai/config.json",
  "model": "github-copilot/gpt-6.2-sol",
  "providers": {
    "github-copilot": {
      "models": {
        "gpt-6.2-sol": {
          "settings": {
            "reasoningEffort": "xhigh"
          }
        }
      }
    }
  },
  "default_agent": "embedded-engineer",
  "experimental": {
    "subagent_depth": 1,
    "todo": true
  },
  "plugins": [
    "./plugins/embedded-repository-inspection"
  ]
}
